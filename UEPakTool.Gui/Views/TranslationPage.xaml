<UserControl x:Class="UEPakTool.Gui.Views.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:UEPakTool.Gui.Models"
             xmlns:vm="clr-namespace:UEPakTool.Gui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TranslationViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <ui:SymbolIcon Symbol="Translate20" FontSize="24" Margin="0,0,12,0" />
            <TextBlock Text="翻译编辑" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <ui:Button Command="{Binding ExportJsonCommand}" Appearance="Secondary"
                        Icon="{ui:SymbolIcon ArrowDownload20}" Margin="0,0,4,0" ToolTip="导出 JSON (与 FModel 格式兼容)">
                    导出
                </ui:Button>
                <ui:Button Command="{Binding ImportTranslationFileCommand}" Appearance="Secondary"
                        Icon="{ui:SymbolIcon ArrowUpload20}" Margin="0,0,4,0" ToolTip="导入 JSON 或 locres 翻译文件">
                    导入
                </ui:Button>
                <ui:Button Command="{Binding SaveLocresFilesCommand}" Appearance="Secondary"
                        Icon="{ui:SymbolIcon Save20}" Margin="0,0,8,0">
                    保存 locres
                </ui:Button>
                <ui:Button Command="{Binding TranslateAllCommand}"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Play20}"
                        Content="一键翻译"
                        IsEnabled="{Binding IsTranslating, Converter={StaticResource InvertBool}}" />
                <ui:Button x:Name="CancelBtn" Command="{Binding CancelTranslateCommand}"
                        Visibility="Collapsed"
                        Appearance="Danger"
                        Icon="{ui:SymbolIcon Dismiss20}"
                        Content="取消翻译"
                        Margin="8,0,0,0" />
                <ProgressBar x:Name="TranslateProgress" Visibility="Collapsed"
                              Value="{Binding TranslationProgress}" Minimum="0" Maximum="100"
                              Width="120" Height="16" Margin="8,0,0,0" />
            </StackPanel>

            <!-- 搜索框 -->
            <ui:TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索 Key 或原文 (实时过滤)..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="16,0" MaxWidth="360" HorizontalAlignment="Right">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search20" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button x:Name="PrevMatchBtn" Click="PrevMatch_Click" Appearance="Secondary"
                        Icon="{ui:SymbolIcon ArrowUp20}" />
                <TextBlock Text="{Binding CurrentMatchIndex}" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock Text="/" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding MatchCount}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:Button x:Name="NextMatchBtn" Click="NextMatch_Click" Appearance="Secondary"
                        Icon="{ui:SymbolIcon ArrowDown20}" />
            </StackPanel>
        </Grid>

        <!-- 翻译表格 -->
        <Border Grid.Row="2" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="TranslationGrid"
                      ItemsSource="{Binding Records}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionUnit="FullRow"
                      SelectionMode="Extended"
                      IsReadOnly="False"
                      Background="Transparent"
                      RowBackground="Transparent"
                      LoadingRow="TranslationGrid_LoadingRow"
                      UnloadingRow="TranslationGrid_UnloadingRow"
                      PreviewKeyDown="TranslationGrid_KeyDown">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Key" Width="280" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DisplayKey, Mode=OneWay}"
                                         IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas" FontSize="11"
                                          />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="原文" Width="280" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Original, Mode=OneWay}"
                                         IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent"
                                          />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="译文" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Translated, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                         BorderThickness="0,0,0,1"
                                         Background="Transparent"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source}" Value="Empty">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Source}" Value="AiGenerated">
                                <Setter Property="Background" Value="#E3F2FD" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Source}" Value="ManuallyEntered">
                                <Setter Property="Background" Value="#E8F5E9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Source}" Value="ManuallyEdited">
                                <Setter Property="Background" Value="#FFF3E0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="12,6"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
