<ui:FluentWindow x:Class="UEPakTool.Gui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:UEPakTool.Gui.ViewModels"
                 Title="TSW 本地化工具 v1.4.4"
                 Height="800"
                 Width="1280"
                 MinHeight="600"
                 MinWidth="960"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel x:Name="MainVM" />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="TSW 本地化工具 v1.4.4" />

        <ui:NavigationView x:Name="NavView"
                           Grid.Row="1"
                           IsPaneOpen="True"
                           OpenPaneLength="80"
                           PaneDisplayMode="LeftFluent"
                           IsBackButtonVisible="Collapsed"
                           BorderThickness="0">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="文件浏览"
                                       Icon="{ui:SymbolIcon Box24}"
                                       Tag="pak"
                                       Click="NavItem_Click" />
                <ui:NavigationViewItem Content="翻译编辑"
                                       Icon="{ui:SymbolIcon Translate24}"
                                       Tag="translation"
                                       Click="NavItem_Click" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Tag="settings"
                                       Click="NavItem_Click" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- 内容区覆盖在 NavigationView 右侧 -->
        <ContentControl Grid.Row="1" Margin="80,0,0,0"
                        Content="{Binding CurrentPage}">
            <ContentControl.Resources>
                <Style TargetType="UserControl" BasedOn="{StaticResource {x:Type UserControl}}" />
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</ui:FluentWindow>
